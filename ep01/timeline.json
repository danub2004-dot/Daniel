{
 "duration": 86.593,
 "segments": [
  {
   "id": "01",
   "voice": "A",
   "start": 0.278,
   "end": 4.046,
   "text": "Ставни опустились на всех окнах. Кроме одного."
  },
  {
   "id": "02",
   "voice": "A",
   "start": 4.25,
   "end": 7.509,
   "text": "Я Маша. Таксистка. Врать не умею."
  },
  {
   "id": "03",
   "voice": "A",
   "start": 7.713,
   "end": 12.398,
   "text": "Сестра влетела в дом последней. Рукав порван. «Калитка», — говорит она."
  },
  {
   "id": "04",
   "voice": "A",
   "start": 12.602,
   "end": 17.139,
   "text": "На двери свежая краска. Метка. Её заметила сестра. Не я."
  },
  {
   "id": "05",
   "voice": "A",
   "start": 17.602,
   "end": 19.028,
   "text": "Сирена. Ночь."
  },
  {
   "id": "06",
   "voice": "A",
   "start": 19.231,
   "end": 21.815,
   "text": "Окна посёлка гаснут. Одно за другим."
  },
  {
   "id": "07",
   "voice": "A",
   "start": 22.019,
   "end": 25.491,
   "text": "А ставня наверху застряла. Окно смотрит в ночь."
  },
  {
   "id": "08a",
   "voice": "A",
   "start": 25.694,
   "end": 26.787,
   "text": "С улицы зовут:"
  },
  {
   "id": "08b",
   "voice": "N",
   "start": 26.926,
   "end": 28.463,
   "text": "Ма-а-ша!"
  },
  {
   "id": "08c",
   "voice": "A",
   "start": 28.602,
   "end": 30.139,
   "text": "Они знают моё имя."
  },
  {
   "id": "09a",
   "voice": "N",
   "start": 30.463,
   "end": 33.065,
   "text": "Маша... ты одна?"
  },
  {
   "id": "09b",
   "voice": "A",
   "start": 33.269,
   "end": 35.843,
   "text": "Сестра шепчет: «Скажи — да»."
  },
  {
   "id": "10",
   "voice": "A",
   "start": 36.046,
   "end": 38.231,
   "text": "Я молчу. Врать я не умею."
  },
  {
   "id": "11",
   "voice": "A",
   "start": 38.435,
   "end": 42.546,
   "text": "Наверху скрипнула половица. Кто-то уже в доме."
  },
  {
   "id": "12",
   "voice": "A",
   "start": 42.75,
   "end": 47.157,
   "text": "Красный фонарик. С улицы его не видно. Батареек — на час."
  },
  {
   "id": "13",
   "voice": "A",
   "start": 47.361,
   "end": 51.991,
   "text": "Свечу в механизм ставни. В шестерёнках — клок синей ткани."
  },
  {
   "id": "14",
   "voice": "A",
   "start": 52.13,
   "end": 54.454,
   "text": "Синей, как рваный рукав сестры."
  },
  {
   "id": "15",
   "voice": "A",
   "start": 54.657,
   "end": 58.824,
   "text": "А из её наушников — шёпот. Тот же голос, что на улице."
  },
  {
   "id": "16",
   "voice": "A",
   "start": 59.194,
   "end": 62.778,
   "text": "Днём она была дома одна. Ставню заклинила она."
  },
  {
   "id": "17",
   "voice": "A",
   "start": 62.981,
   "end": 68.056,
   "text": "Жму на брелок — во дворе воет моё такси. Тень прыгает из окна к машине."
  },
  {
   "id": "18",
   "voice": "A",
   "start": 68.259,
   "end": 72.167,
   "text": "Я захлопываю ставню руками. Сестра не говорит ни слова."
  },
  {
   "id": "19a",
   "voice": "A",
   "start": 72.722,
   "end": 75.88,
   "text": "Фонарик погас. Дальше — только темнота."
  },
  {
   "id": "19b",
   "voice": "A",
   "start": 76.713,
   "end": 79.981,
   "text": "Шесть пятьдесят девять. Три удара в дверь."
  },
  {
   "id": "20",
   "voice": "N",
   "start": 80.537,
   "end": 84.741,
   "text": "Маша. Ты же не умеешь врать. Кто заклинил окно?"
  }
 ],
